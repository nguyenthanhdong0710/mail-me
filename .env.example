# Secrets for mail-me. Copy to .env and fill in. config.json refers to these by name.
# Write values without quotes, and keep comments on their own lines.

# API key(s) for the AI provider(s) in ai.gatekeeper / ai.analyst / ai.scheduler
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Only for Anthropic keys not scoped to a workspace (set ai.*.workspace_id_env to this name)
# ANTHROPIC_WORKSPACE_ID=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Client secret of YOUR Google OAuth app (auth.google.client_secret_env).
# Gmail accounts use OAuth sign-in (`mail-me auth <account-id>`), so no mailbox password is needed.
# Sign-in grants are stored in data/grants/, not here.
GOOGLE_OAUTH_CLIENT_SECRET=

# Only if you use Telegram (delivery.telegram.enabled). Token from @BotFather.
# TELEGRAM_BOT_TOKEN=

# Only if you use email reports over SMTP with a password (delivery.email.smtp.password_env).
# Not needed with delivery.email.oauth or a Telegram-only setup.
# SMTP_PASSWORD=

# Only for password-based mail accounts (Yahoo, iCloud, Fastmail, Zoho, GMX, AOL, other IMAP
# servers): one app password per account, named in accounts[].imap.password_env.
# YAHOO_IMAP_PASSWORD=
