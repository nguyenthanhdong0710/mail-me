# Secrets for mail-me. Copy to .env and fill in. config.json refers to these by name.

# IMAP app password for each monitored account (accounts[].imap.password_env)
SCHOOL_IMAP_PASSWORD=

# SMTP password for the email delivery channel (delivery.email.smtp.password_env)
SMTP_PASSWORD=

# API key(s) for the AI provider(s) in ai.gatekeeper / ai.analyst
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Only for Anthropic keys not scoped to a workspace (set ai.*.workspace_id_env to this name)
# ANTHROPIC_WORKSPACE_ID=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Only if delivery.telegram.enabled is true. Token from @BotFather.
TELEGRAM_BOT_TOKEN=
